# ---------------- 心里话（第 stage 段, 0..4） ----------------
static func heart_script(idx: int, stage: int) -> Array:
	if not _available(idx):
		return []
	var id := _id(idx)
	if not HEARTS.has(id):
		return []
	var st := mini(maxi(int(stage), 0), 4)
	var h: Dictionary = _her(idx)
	var lines: Array = []
	lines.append({"fx": "bg", "scene": "camp", "tod": "night", "dur": 1.2})
	lines.append({"fx": "weather", "mode": "embers", "amount": 26})
	lines.append({"fx": "show", "who": _f(idx), "at": "ml"})
	lines.append({"fx": "show", "who": "you", "at": "mr"})
	# 每段开头节奏微调: 第 3/4 段两人凑近一档
	if st >= 3:
		lines.append({"fx": "move", "who": _f(idx), "at": "m"})
		lines.append({"fx": "move", "who": "you", "at": "mr"})
	for row in HEARTS[id][st]:
		if row[0] == "h":
			lines.append(_line(h, row[1]))
		else:
			lines.append(_line(_me(), row[1]))
	lines.append({"fx": "hide", "who": "all"})
	return lines

static func _id(idx: int) -> String:
	return "rq_%02d" % idx

