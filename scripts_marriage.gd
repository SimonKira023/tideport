	lines.append({"fx": "show", "who": "you", "at": "mr"})
	lines.append({"fx": "act", "who": _f(idx), "pose": "wave"})
	lines.append(_line(h, "真没想到, 我的婚礼会在海边办. 小时候幻想过好多回, 都没这个好看."))
	lines.append(_line(_me(), "全岛的人都来了. 布恩还在偷偷抹眼睛呢."))
	lines.append(_line(h, "让他抹! 他上次还赌说我们俩谁都不会先开口."))
