	lines.append(_line(_me(), "往后的日子, 不管出海, 种田还是守着炉火--我们一起."))
	if WEDDING_VOW.has(id):
		lines.append(_line(h, WEDDING_VOW[id]))
	else:
		lines.append(_line(h, "一起. 这句话我记下了, 一辈子不改口."))
	lines.append({"fx": "act", "who": _f(idx), "pose": "bob"})
	lines.append({"fx": "act", "who": "you", "pose": "bob"})
	lines.append({"fx": "wait", "t": 1.0})
	lines.append({"fx": "bgm_off"})
	lines.append({"fx": "hide", "who": "all"})
	return lines
