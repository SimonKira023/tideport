static func propose_script(idx: int) -> Array:
	if not _available(idx):
		return []
	var id := _id(idx)
	var h: Dictionary = _her(idx)
	var lines: Array = []
	lines.append({"fx": "bg", "scene": "camp", "tod": "dusk", "dur": 1.4})
	lines.append({"fx": "weather", "mode": "fireflies", "amount": 30})
	lines.append({"fx": "show", "who": _f(idx), "at": "m"})
	lines.append({"fx": "show", "who": "you", "at": "mr"})
	lines.append({"fx": "focus", "who": _f(idx)})
	lines.append(_line(h, "今晚叫我出来, 是有什么事吗? 你表情怪正经的."))
	lines.append(_line(_me(), "嗯. 有件事, 想了很久, 今天必须说出来."))
	lines.append({"fx": "act", "who": "you", "pose": "nod"})
	lines.append(_line(_me(), "从上岛那天算起, 我们一起熬过了这么多日子. 往后的日子, 我想每天都睁眼看到你."))
	lines.append({"fx": "duck"})
	lines.append(_line(_me(), "嫁给我, 好吗?"))
	lines.append({"fx": "unduck"})
	lines.append({"fx": "act", "who": _f(idx), "pose": "jump"})
	if PROPOSE_REPLY.has(id):
		for t in PROPOSE_REPLY[id]:
			lines.append(_line(h, t))
	else:
		lines.append(_line(h, "......你还真备了戒指?!"))
		lines.append(_line(h, "好. 一万个好. 这辈子我都不下船了!"))
	lines.append({"fx": "sfx", "name": "ui_open"})
	lines.append({"fx": "flash"})
	lines.append({"fx": "hide", "who": "all"})
	return lines

