; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="潮汐港"
run/main_scene="res://scene/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon_256.png"

[autoload]

TimeManager="*uid://4h0uhrmspmu3"
Weather="*res://weather.gd"
Inventory="*uid://yyr2cvddofg1"
Farm="*uid://b0mkxljqjvufy"
Wallet="*res://wallet.gd"
Audio="*res://audio_manager.gd"
Slaves="*res://slaves.gd"
Floor="*res://floor.gd"
Crafting="*res://crafting.gd"
FloorIcon="*res://floor_icon.gd"
Trees="*res://trees.gd"
OreVein="*res://ore_data.gd"
Structures="*res://structures.gd"
Legion="*res://legion_manager.gd"
Research="*res://research.gd"
Voyage="*res://voyage.gd"
Nations="*res://nations.gd"
SaveManager="*res://save_manager.gd"
Quests="*res://quests.gd"
Recruits="*res://recruits.gd"
Marriage="*res://marriage.gd"
FishJournal="*res://fish_journal.gd"
Cutscenes="*res://cutscenes.gd"
Fullscreen="*res://fullscreen_toggle.gd"

[display]

window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

version_control/autoload_on_startup=true

[global_group]

player=""

